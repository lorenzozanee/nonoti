<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name="com.example.nonoti.ExternalNotificationPublisherReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.nonoti.test.POST_NOTIFICATION" />
                <action android:name="com.example.nonoti.test.CANCEL_NOTIFICATION" />
                <action android:name="com.example.nonoti.test.CANCEL_ALL_NOTIFICATIONS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
